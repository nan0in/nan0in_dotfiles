/* Clavis Material-inspired Dracula; inherits fonts and user preferences. */
@import url("@BASE_CSS@");
@define-color theme_bg_color #282a36;
@define-color theme_fg_color #f8f8f2;
@define-color theme_base_color #282a36;
@define-color theme_text_color #f8f8f2;
@define-color theme_selected_bg_color #bd93f9;
@define-color theme_selected_fg_color #282a36;
@define-color accent_color #bd93f9;
@define-color accent_bg_color #bd93f9;
@define-color accent_fg_color #282a36;
window, .background { background-color: #282a36; color: #f8f8f2; }
headerbar, toolbar { background-image: none; background-color: #282a36; border: 0; box-shadow: none; padding: 6px; }
button { background-image: none; border-radius: 10px; border: 1px solid #44475a; padding: 5px 9px; box-shadow: none; }
button:hover { background-color: rgba(189,147,249,0.18); border-color: #bd93f9; }
button:checked, button:active, button.suggested-action { background-color: #bd93f9; color: #282a36; }
entry, combobox button { border-radius: 10px; box-shadow: none; }
entry:focus { border-color: #bd93f9; }
.sidebar, .sidebar.view { background-color: #21222c; }
.sidebar row { border-radius: 8px; margin: 2px 6px; padding: 4px; }
.view:selected, .sidebar row:selected { background-color: #44475a; color: #f8f8f2; }
notebook > header { background-color: #282a36; border: 0; }
notebook > header tab { border-radius: 8px 8px 0 0; padding: 6px 10px; }
notebook > header tab:checked { background-color: #44475a; border-bottom: 2px solid #bd93f9; }
menu, .menu, popover { border-radius: 12px; border-color: #44475a; }
scrollbar slider { border-radius: 8px; min-width: 6px; min-height: 6px; }
