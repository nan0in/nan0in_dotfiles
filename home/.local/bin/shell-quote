#!/usr/bin/env python3
"""Offline fortune + cowsay, wrapping Chinese by terminal cell width."""
import argparse
import json
import os
from pathlib import Path
import random
import shutil
import subprocess
import sys
import unicodedata


def cells(character):
    if unicodedata.combining(character):
        return 0
    return 2 if unicodedata.east_asian_width(character) in "WF" else 1


def wrap(text, width=42):
    lines = []
    for paragraph in text.splitlines():
        line, size = "", 0
        for char in paragraph:
            if unicodedata.category(char).startswith("C"):
                continue
            length = cells(char)
            if size + length > width and line:
                boundary = line.rfind(" ")
                if char.isascii() and char.isalnum() and line[-1].isascii() and line[-1].isalnum() and boundary > 0:
                    lines.append(line[:boundary])
                    line = line[boundary + 1:]
                    size = sum(cells(c) for c in line)
                else:
                    lines.append(line)
                    line, size = "", 0
            line += char
            size += length
        lines.append(line)
    return lines or [""]


def load_groups(root):
    """Load user weights, dropping missing databases and zero-weight groups."""
    fallback = {"acg": {"weight": 70, "files": ["hitokoto/a", "hitokoto/b", "hitokoto/c"]},
                "chinese": {"weight": 30, "files": ["hitokoto/d", "hitokoto/i"]}}
    try:
        settings = json.loads((root / "settings.json").read_text())
        if not isinstance(settings, dict):
            raise ValueError("Expected an object")
    except (OSError, ValueError):
        settings = fallback
    groups = {}
    for name, item in settings.items():
        if not isinstance(item, dict):
            continue
        weight = item.get("weight", 0)
        if not isinstance(weight, (int, float)) or not 0 < weight <= 100:
            continue
        patterns = item.get("files", [])
        if not isinstance(patterns, list):
            continue
        files = set()
        for pattern in patterns:
            if not isinstance(pattern, str) or Path(pattern).is_absolute() or ".." in Path(pattern).parts:
                continue
            for path in root.glob(pattern):
                if path.is_file() and path.with_name(path.name + ".dat").is_file():
                    files.add(str(path))
        if files:
            groups[name] = {"weight": weight, "files": sorted(files)}
    return groups


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--text", action="store_true", help="Print quote without cowsay")
    parser.add_argument("--category", help="Choose a category from settings.json")
    parser.add_argument("--list", action="store_true", help="List enabled categories and weights")
    options = parser.parse_args()
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    groups = load_groups(config / "fortune")
    if options.list:
        print(json.dumps(groups, ensure_ascii=False, indent=2))
        return
    if options.category and options.category not in groups:
        parser.error("Category unavailable: " + options.category)
    selected = []
    if groups:
        category = options.category or random.choices(
            list(groups), weights=[item["weight"] for item in groups.values()])[0]
        selected = groups[category]["files"]
    text = "今天也要元气满满！"
    if shutil.which("fortune"):
        try:
            result = subprocess.run(["fortune", *selected], capture_output=True,
                                    encoding="utf-8", errors="replace", timeout=3)
            if result.returncode == 0 and result.stdout.strip():
                text = result.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass
    if options.text:
        print(text)
        return
    lines = wrap(text)
    if not shutil.which("cowsay"):
        print("\n".join(lines))
        return
    # cowsay measures bytes, not display cells. Render ASCII stand-ins and then
    # replace them with equal-cell-width Unicode text, leaving the cow untouched.
    width = max(8, max(sum(cells(c) for c in line) for line in lines))
    tokens = [f"Q{index:06d}Q".ljust(width, "Q") for index in range(len(lines))]
    piano = Path.home() / ".cows/piano.cow"
    if not piano.is_file():
        # stow also makes the repository's piano.cow available here.
        piano = Path.home() / "piano.cow"
    args = ["cowsay", "-n"]
    if piano.is_file():
        args += ["-f", str(piano)]
    try:
        result = subprocess.run(args, input="\n".join(tokens) + "\n", capture_output=True,
                                encoding="utf-8", errors="replace", timeout=3)
        if result.returncode:
            raise OSError("cowsay failed")
        output = result.stdout
        for token, line in zip(tokens, lines):
            output = output.replace(token, line + " " * (width - sum(cells(c) for c in line)), 1)
        sys.stdout.write(output)
    except (OSError, subprocess.TimeoutExpired):
        print("\n".join(lines))


if __name__ == "__main__":
    main()
