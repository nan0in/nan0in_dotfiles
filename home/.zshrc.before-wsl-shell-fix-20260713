rm() {
  if echo "$@" | grep -Eq -- '-[a-z]*f.*[a-z]*r|-[a-z]*r.*[a-z]*f'; then
    local targets=()
    local arg
    for arg in "$@"; do
      if [[ "$arg" != -* ]]; then
        targets+=("$arg")
      fi
    done

    echo -e "\033[1;31m[🚨警告] 你正在尝试使用 rm -rf！\033[0m"
    echo -e "\033[1;33m待删除的目标对象：\033[0m"
    printf "  - %s\n" "${targets[@]}"
    echo -n "确认执行？[y/N] "
    read answer

    if [[ ! "$answer" =~ ^[Yy](es)?$ ]]; then
      echo "❎ 操作已终止。"
      return
    fi
  fi

  command rm "$@"
}

