if command -v yazi >/dev/null 2>&1; then
  yazi() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    command yazi "$@" --cwd-file="$tmp"
    if [[ -f "$tmp" ]]; then
      IFS= read -r cwd < "$tmp"
      [[ -n "$cwd" && "$cwd" != "$PWD" && -d "$cwd" ]] && builtin cd -- "$cwd"
      rm -f -- "$tmp"
    fi
  }
  alias y='yazi'
fi

