__wsl_windows_path_to_unix() {
  emulate -L zsh

  local winpath="$1"
  [[ -z "$winpath" ]] && return 1

  if [[ "$winpath" == file://* ]]; then
    winpath="${winpath#file://}"
    winpath="${winpath#localhost}"
    [[ "$winpath" == /[A-Za-z]:[\\/]* ]] && winpath="${winpath#/}"
    winpath="${winpath//%20/ }"
  fi

  [[ "$winpath" == [A-Za-z]:[\\/]* ]] || return 1

  if command -v wslpath >/dev/null 2>&1; then
    local converted
    converted="$(wslpath -u "$winpath" 2>/dev/null)" && [[ -n "$converted" ]] && {
      print -r -- "$converted"
      return 0
    }
  fi

  [[ "$winpath" =~ '^([A-Za-z]):[\\/]' ]] || return 1

  local drive="${(L)match[1]}"
  local rest="${winpath#?:}"
  rest="${rest//\\//}"
  rest="${rest#/}"
  print -r -- "/mnt/$drive/$rest"
}

cd() {
  emulate -L zsh

  local -a args
  args=("$@")

  local idx=1
  while (( idx <= ${#args} )); do
    case "${args[$idx]}" in
      --)
        (( idx++ ))
        break
        ;;
      -)
        builtin cd "$@"
        return
        ;;
      -[qPLs]*|-[0-9]*|+[0-9]*)
        (( idx++ ))
        ;;
      *)
        break
        ;;
    esac
  done

  if (( idx <= ${#args} )); then
    local converted
    if converted="$(__wsl_windows_path_to_unix "${args[$idx]}")"; then
      args[$idx]="$converted"
    fi
  fi

  builtin cd "${args[@]}"
}

